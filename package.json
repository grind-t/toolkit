{
  "name": "@grind-t/toolkit",
  "version": "2.6.0",
  "description": "Natural problem solver's toolkit",
  "homepage": "https://github.com/grind-t/toolkit#readme",
  "bugs": {
    "url": "https://github.com/grind-t/toolkit/issues"
  },
  "license": "ISC",
  "author": "grind-t",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grind-t/toolkit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./nullish": {
      "types": "./dist/nullish/index.d.mts",
      "import": "./dist/nullish/index.mjs"
    },
    "./string": {
      "types": "./dist/string/index.d.mts",
      "import": "./dist/string/index.mjs"
    },
    "./array": {
      "types": "./dist/array/index.d.mts",
      "import": "./dist/array/index.mjs"
    },
    "./date": {
      "types": "./dist/date/index.d.mts",
      "import": "./dist/date/index.mjs"
    },
    "./fn": {
      "types": "./dist/fn/index.d.mts",
      "import": "./dist/fn/index.mjs"
    },
    "./object": {
      "types": "./dist/object/index.d.mts",
      "import": "./dist/object/index.mjs"
    },
    "./stream": {
      "types": "./dist/stream/index.d.mts",
      "import": "./dist/stream/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "test:unit": "node --experimental-transform-types --experimental-test-module-mocks --test \"src/**/*.unit.test.ts\"",
    "test:e2e": "node --experimental-transform-types --experimental-test-module-mocks --test \"src/**/*.e2e.test.ts\"",
    "test": "node --experimental-transform-types --experimental-test-module-mocks --test \"src/**/*.test.ts\"",
    "build": "tsdown"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "tsdown": "latest",
    "typescript": "latest"
  }
}
